<?xml version="1.0" encoding="utf-8"?>
<!--
  서로 기댄 미니 하트 두 개가 쉬지 않고 번갈아 "콩-닥" 뛰는 애니메이션 (12장 × 0.1초 = 1.2초 한 바퀴).
  위젯의 ProgressBar 에 넣어 재생한다. scripts/gen_heart_frames.js 로 생성.
  - 꺼진 화면 시계(AOD)는 1초에 30번만 화면을 바꾼다. 그림 한 장을 0.1초(화면 3번)로 고르게 맞췄다.
  - AOD 에서 잠금화면 프로그램이 애니메이션을 멈추면 보통 첫 장(0번, 쉬는 자세)으로 멈춘다.
    어느 장에서 멈춰도 두 하트가 예쁘게 겹쳐 보이도록 모든 장을 같은 자세로 만들었다.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/heart_beat_0" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_1" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_2" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_3" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_4" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_5" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_6" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_7" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_8" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_9" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_10" android:duration="100" />
    <item android:drawable="@drawable/heart_beat_11" android:duration="100" />
</animation-list>
