<?xml version="1.0" encoding="utf-8"?>
<!-- 4 떠오르는 하트: 글자 뒤로 작은 하트들이 떠오른다. 글자·그림 크기는 HeartDesigns.kt 가 위젯 칸에 맞춰 키우고 줄인다 (scripts/gen_heart_layouts.js 로 생성) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
<FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
<ProgressBar android:id="@+id/heart_fx" android:layout_width="100dp" android:layout_height="60dp" android:importantForAccessibility="no" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/hd_rise" android:layout_gravity="center" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="center">
<TextView android:id="@+id/heart_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="32sp" android:textColor="#FFFFFFFF" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowDy="1" android:shadowRadius="6" android:layout_gravity="center_horizontal" />
<TextView android:id="@+id/heart_since" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="11sp" android:textColor="#FFFFFFFF"  android:shadowColor="#CC000000" android:shadowDy="1" android:shadowRadius="6" android:layout_gravity="center_horizontal" android:layout_marginTop="3dp" />
</LinearLayout>
</FrameLayout>
</FrameLayout>
