<?xml version="1.0" encoding="utf-8"?>
<!--
  하트 위젯 본문 (홈 화면 · 잠금 화면 공용).
  ( [겹친 하트 두 개] 103일    )   ← 옅은 반투명 알약 바탕
  (                26.07.17 )   ← 날짜는 숫자 시작점에 맞춤 (왼쪽 여백은 코드에서 하트 폭만큼)
  - 하트와 숫자는 한 줄로 묶어 세로 가운데를 맞춘다.
  - 흰 글자 + 진한 그림자 + 반투명 바탕이라 밝은 배경화면에서도 또렷하다.
  - 하트 애니메이션은 ProgressBar 의 indeterminateDrawable(프레임 애니메이션)로 재생한다.
    (위젯은 일반 애니메이션을 못 돌리지만 ProgressBar 의 진행 표시는 움직인다)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/heart_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/heart_pill_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/heart_anim"
                android:layout_width="30dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/heart_beat_anim"
                android:indeterminateOnly="true" />

            <TextView
                android:id="@+id/heart_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/heart_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="5"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
