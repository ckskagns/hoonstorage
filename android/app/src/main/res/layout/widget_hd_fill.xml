<?xml version="1.0" encoding="utf-8"?>
<!-- 7 채워지는 하트: 다음 100일까지 온 만큼 채워진 하트 + 반짝이. 글자·그림 크기는 HeartDesigns.kt 가 위젯 칸에 맞춰 키우고 줄인다 (scripts/gen_heart_layouts.js 로 생성) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="center">
<FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" >
<ProgressBar android:id="@+id/heart_fill" style="?android:attr/progressBarStyleHorizontal" android:layout_width="44dp" android:layout_height="44dp" android:importantForAccessibility="no" android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/hd_fill_progress" />
<ProgressBar android:id="@+id/heart_anim" android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/hd_twinkle" android:layout_gravity="top|end" />
</FrameLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
<TextView android:id="@+id/heart_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="24sp" android:textColor="#FFFFFFFF" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowDy="1" android:shadowRadius="6"  />
<TextView android:id="@+id/heart_since" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textSize="11sp" android:textColor="#FFFFFFFF"  android:shadowColor="#CC000000" android:shadowDy="1" android:shadowRadius="6" android:layout_marginTop="2dp" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
