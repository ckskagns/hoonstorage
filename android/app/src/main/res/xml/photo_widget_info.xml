<?xml version="1.0" encoding="utf-8"?>
<!-- 사진 디데이 위젯. 기본 2×2, 놓을 때 사진을 고르고, 길게 눌러 "설정"으로 바꿀 수 있다. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/photo_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_photo"
    android:configure="com.uridul.app.PhotoWidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="57dp"
    android:minResizeHeight="57dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
