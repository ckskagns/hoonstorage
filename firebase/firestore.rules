rules_version = '2';

// 우리둘 Firestore 보안 규칙
// - 커플 공간(couples/{id})은 members 에 들어 있는 최대 2명만 읽고 쓸 수 있다.
// - 두 번째 멤버는 유효한 1회용 초대 토큰(invites/{token})을 "같은 배치에서 삭제"하면서만 들어올 수 있다.
// - 서버 함수 없이 규칙만으로 처리하므로 무료(Spark) 요금제에서 동작한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function coupleAfter(coupleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId));
    }

    // 내 프로필 (coupleId, displayName). 본인만 접근.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 1회용 초대 토큰. 문서 ID(토큰)를 아는 사람만 단건 조회 가능, 목록 조회는 불가.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && token.size() >= 32
        && request.resource.data.keys().hasOnly(['coupleId', 'createdBy', 'createdAt', 'expiresAt',
                                                 'partnerName', 'partnerCharacter'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h')
        && coupleAfter(request.resource.data.coupleId).data.members == [request.auth.uid];

      // 만든 사람은 언제든 삭제, 참여자는 연결 배치 안에서 삭제
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || request.auth.uid in coupleAfter(resource.data.coupleId).data.members);

      allow update: if false;
    }

    match /couples/{coupleId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // 캐릭터(characters 맵)는 자기 것만 바꿀 수 있다
      function onlyMyCharacter() {
        return request.resource.data.get('characters', {}).diff(resource.data.get('characters', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      // 아직 없는 문서는 읽어도 아무 정보가 없으므로 허용 (만들기 직후 화면 되돌아감 방지)
      allow get: if signedIn() && (resource == null || isMember());
      allow list: if false;

      // 커플 공간 생성: 만든 사람 혼자인 상태로만 생성 가능
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'startDate', 'countFromOne', 'createdAt',
                                                 'characters', 'partnerDefaults'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.get('characters', {}).keys().hasOnly([request.auth.uid])
        && request.resource.data.startDate is string
        && request.resource.data.countFromOne is bool;

      // 멤버의 일반 수정: 멤버 목록은 못 바꾸고, 이름·캐릭터는 자기 것만.
      // partnerDefaults(연결 전 상대 이름·캐릭터)는 아직 혼자일 때만 바꿀 수 있다.
      allow update: if isMember()
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['startDate', 'countFromOne', 'names', 'characters', 'partnerDefaults'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys()
             .hasOnly([request.auth.uid])
        && onlyMyCharacter()
        && (!('partnerDefaults' in request.resource.data.diff(resource.data).affectedKeys())
            || resource.data.members.size() == 1);

      // 초대 링크로 참여: 아직 1명인 공간에, 유효한 토큰을 같은 배치에서 소진하며 나 자신만 추가
      allow update: if signedIn()
        && resource.data.members.size() == 1
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'names', 'joinToken', 'characters'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys()
             .hasOnly([request.auth.uid])
        && onlyMyCharacter()
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.coupleId == coupleId
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinToken)).data.expiresAt > request.time
        && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.joinToken));

      allow delete: if false;

      // 공유 캘린더 일정: 커플 멤버 두 사람만 읽고 쓴다
      match /events/{eventId} {
        function isCoupleMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        function isDay(v) {
          return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }

        // 장소 (선택): 이름 + 지도 앱 링크 + 어느 지도 앱인지. API 없이 링크만 저장한다.
        function validPlace(p) {
          return p is map
            && p.keys().hasOnly(['name', 'url', 'app'])
            && p.name is string && p.name.size() > 0 && p.name.size() <= 100
            && (!('url' in p) || p.url == null || (p.url is string && p.url.size() <= 500 && p.url.matches('^https?://.*')))
            && (!('app' in p) || p.app == null || p.app in ['naver', 'kakao', 'google']);
        }

        function validEvent(d) {
          return d.keys().hasOnly(['title', 'date', 'endDate', 'allDay', 'time', 'memo', 'place', 'timeline',
                                   'remind', 'repeat', 'skip', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
            // 반복: 매주·매달·매년, 뺀 날 목록은 200개까지
            && (!('repeat' in d) || d.repeat == null || d.repeat in ['weekly', 'monthly', 'yearly'])
            && (!('skip' in d) || d.skip == null || (d.skip is list && d.skip.size() <= 200))
            && (!('place' in d) || d.place == null || validPlace(d.place))
            // 알림: 몇 분 전 (-1 끄기 ~ 1440 하루 전)
            && (!('remind' in d) || d.remind == null || (d.remind is int && d.remind >= -1 && d.remind <= 1440))
            // 타임라인: 시간대 목록 (시작·끝·내용·장소), 하루 최대 12개
            && (!('timeline' in d) || d.timeline == null || (d.timeline is list && d.timeline.size() <= 12))
            && d.title is string && d.title.size() > 0 && d.title.size() <= 100
            && isDay(d.date) && isDay(d.endDate) && d.endDate >= d.date
            && d.allDay is bool
            && ((d.allDay && d.time == null)
                || (!d.allDay && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')))
            && d.memo is string && d.memo.size() <= 1000
            && d.updatedBy == request.auth.uid;
        }

        allow read: if isCoupleMember();
        // 만든 사람은 커플 멤버여야 한다 (지운 상대 일정을 "되돌리기" 할 때 원래 만든 사람 그대로 다시 만든다)
        allow create: if isCoupleMember()
          && validEvent(request.resource.data)
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        allow update: if isCoupleMember()
          && validEvent(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isCoupleMember();
      }

      // 가고 싶은 곳: 지도 앱에서 공유받은 장소 목록 (두 사람만)
      match /wishes/{wishId} {
        function isWishMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        function validWish(d) {
          return d.keys().hasOnly(['name', 'url', 'app', 'memo', 'visited', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 100
            && (!('url' in d) || d.url == null || (d.url is string && d.url.size() <= 500 && d.url.matches('^https?://.*')))
            && (!('app' in d) || d.app == null || d.app in ['naver', 'kakao', 'google'])
            && d.memo is string && d.memo.size() <= 200
            && d.visited is bool
            && d.updatedBy == request.auth.uid;
        }

        allow read: if isWishMember();
        allow create: if isWishMember()
          && validWish(request.resource.data)
          && request.resource.data.createdBy in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        allow update: if isWishMember()
          && validWish(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isWishMember();
      }
    }
  }
}
